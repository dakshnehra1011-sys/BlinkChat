# BlinkChat Environment Configuration

# Application Port / URLs
PORT=8787
FRONTEND_URL=http://localhost:5173
WORKER_URL=http://localhost:8787

# Authentication Secret (Used for HMAC JWT session tokens)
JWT_SIGNING_SECRET=replace-with-a-local-random-secret-at-least-32-characters-long

# STUN / TURN Configuration
# Default Google STUN server for local development
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay credentials (RFC 5766) for symmetric NAT traversal
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional Cloudflare Realtime TURN credentials API.
# Create a TURN key in Cloudflare Realtime, then add these as Worker secrets.
# The API token needs Calls: Write permission; only short-lived ICE credentials
# are returned to authenticated clients. TURN relays media when direct ICE fails.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Email Delivery (Optional in development - defaults to console logger)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@blinkchat.local
RESEND_API_KEY=
