# BlinkChat Environment Configuration

# Application Port / URLs
PORT=8787
FRONTEND_URL=http://localhost:5173
WORKER_URL=http://localhost:8787

# Authentication Secret (Used for HMAC JWT session tokens)
JWT_SECRET=development_super_secret_jwt_key_min_32_characters_long_for_security

# STUN / TURN Configuration
# Default Google STUN server for local development
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay credentials (RFC 5766) for symmetric NAT traversal
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Email Delivery (Optional in development - defaults to console logger)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@blinkchat.local
RESEND_API_KEY=
