{
  "name": "blinkchat-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun --filter '*' build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "dev": "bun run --parallel --filter '*' --if-present dev",
    "dev:worker": "bun --filter @blinkchat/worker dev",
    "dev:web": "bun --filter @blinkchat/web dev",
    "db:generate": "bun --filter @blinkchat/database db:generate",
    "db:migrate": "bun --filter @blinkchat/database db:migrate",
    "db:migrate:local": "bun run --cwd apps/worker wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "bun run --cwd apps/worker wrangler d1 migrations apply blinkchat_d1 --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
